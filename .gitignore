# This .gitignore is optimized for Unity projects

## Unity generated files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
# /[Bb]uild/
# /[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

## Memory captured files
*.memory
*.mem

## Visual Studio / MonoDevelop / Rider / VS Code generated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

## Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

## Unity generated crash reports
crashlytics-build/
[Cc]rash[Dd]umps/

## Unity addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/

## Unity Asset Store backup files
*.unitypackage.backup
*.unitypackage.meta.bak

## Unity cache folder
/[Aa]ssets/[Aa]sset[Cc]ache/

## Unity performance testing
*.nunit

## Autogenerated JetBrains Rider plugin
/.idea/

## VS Code
/.vscode/

## Built script assemblies
*.dll

## Unity test results
[Rr]eport.xml
*.trx

## Benchmark results
*.benchmark.*

## Unity Accelerator
/[Uu]nity[Aa]ccelerator/

## Android
/[Bb]in/
/[Gg]radle/
/[Ll]ocal.properties
/*.keystore
/*.jks
/[Gg]radle[Ll]ocal.properties

## iOS
/[Pp]ods/
/[Ii]os/
/[Dd]erived[Dd]ata/
/*.xcworkspace
/*.xcodeproj
/*.xcuserdata

## macOS
*.DS_Store
.AppleDouble
.LSOverride
._*

## Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

## Linux
*~
.directory

## WebGL
/[Bb]uild/[Ww]ebGL/

## Large files (adjust based on your needs)
*.psd
*.tga
*.tif
*.png
*.jpg
*.jpeg
*.mp3
*.wav
*.aiff
*.ogg
*.mp4
*.mov
*.avi
*.mkv
*.blend
*.fbx
*.obj
*.max
*.ma
*.mb

## But exclude these large file types if they're in specific folders (optional)
!Assets/StreamingAssets/**/*.mp3
!Assets/StreamingAssets/**/*.wav
!Assets/StreamingAssets/**/*.mp4